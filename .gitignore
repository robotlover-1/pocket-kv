# ============================================
# Build outputs
# ============================================
/build/
# repo-reorg 后 kvstore/ 为代码目录，不再整体忽略；只忽略根二进制
/kvstore/kvstore
/kvs_hash
*.o
*.obj
*.exe

# ============================================
# Test runtime artifacts (generated by scripts)
# ============================================
/artifacts/**
!/artifacts/.gitkeep
!/artifacts/repl/
!/artifacts/repl/.gitkeep
!/artifacts/rdma/
!/artifacts/rdma/.gitkeep
!/artifacts/persist/
!/artifacts/persist/.gitkeep
!/artifacts/bench/
!/artifacts/bench/.gitkeep
!/artifacts/legacy/
!/artifacts/legacy/.gitkeep

# Temporary replication test data
/tmp_repl_test/

# ============================================
# Runtime data (generated during server runtime)
# ============================================
*.aof
*.dump
*.aof.replstate
*.rdb
kvstore.pid

# ============================================
# Python caches
# ============================================
**/__pycache__/
*.pyc
*.pyo

# ============================================
# eBPF / BPF generated files
# ============================================
*.bpf.o

# ============================================
# Perf test generated files
# ============================================
/tests/perf/vmlinux.h
/tests/perf/test_ebpf_forward_qps
/tests/perf/test_ebpf_hset_qps
/tests/perf/test_rdma_throughput
/tests/perf/test_sendfile_throughput
/tests/perf/test_kprobe_echo_qps
/tests/perf/test_kprobe_repl_qps
/tests/perf/test_slave_receiver
/tmp/perf_test_file

# ============================================
# Local logs and debug files
# ============================================
*.log
*.pid
*.out
*.err
*.core
*.trace

# ============================================
# Editor / IDE / OS noise
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*
.cache/

# ============================================
# Benchmark generated outputs
# ============================================
benchmarks/data/pipeline_bench/*.txt
benchmarks/data/pipeline_bench/pipeline_summary.csv

# ============================================
# Environment / config overrides (local only)
# ============================================
.env
.env.local

# ============================================
# ai-chat 组件运行时产出（组件提升到根后沿用原 ai-chat/.gitignore）
# ============================================
bin/
runtime/

monitoring/grafana/
monitoring/prometheus/data/
monitoring/logs/
monitoring/pids/
tests/test_repl_5w5w
tests/test_fullsync_protocol

# ============================================
# kvstore/ 编译产物与运行产物（repo-reorg 后路径前缀）
# 对应上面根目录规则，重构后 kvstore 成目录需加前缀
# ============================================
/kvstore/build/
/kvstore/tmp_repl_test/
/kvstore/tests/perf/vmlinux.h
/kvstore/tests/perf/test_ebpf_forward_qps
/kvstore/tests/perf/test_ebpf_hset_qps
/kvstore/tests/perf/test_rdma_throughput
/kvstore/tests/perf/test_sendfile_throughput
/kvstore/tests/perf/test_kprobe_echo_qps
/kvstore/tests/perf/test_kprobe_repl_qps
/kvstore/tests/perf/test_slave_receiver
/kvstore/tests/test_fullsync_protocol
/kvstore/benchmarks/data/pipeline_bench/
/kvstore/artifacts/**
!/kvstore/artifacts/.gitkeep
